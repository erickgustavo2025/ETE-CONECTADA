# Endereço IP/hostname desta máquina na rede local, sem protocolo ou porta.
# Use o mesmo valor de apps/portal/.env.local e reinicie os servidores após mudar.
NEXT_PUBLIC_LAN_HOST=192.168.1.120

# URL pública aprovada do portal, informada ao construir a versão publicada.
NEXT_PUBLIC_PORTAL_LOGIN_URL=

# Origem pública aprovada do site, sem caminho/consulta/credenciais. Obrigatória para redirects de produção.
# Exemplo de formato: https://site.example.invalid. Desenvolvimento local pode deixar vazio.
SITE_PUBLIC_URL=

# Ativar somente em produção após verificar certificado, renovação e proxy da origem definitiva.
HTTPS_VERIFIED=
