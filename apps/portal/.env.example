# Endereço IP/hostname desta máquina na rede local, sem protocolo ou porta.
# Altere também apps/site/.env.local e reinicie os servidores após mudar.
NEXT_PUBLIC_LAN_HOST=192.168.1.120

# URL pública do site institucional; usada em produção.
NEXT_PUBLIC_SITE_URL=https://eteconectada.com

# Conexão PostgreSQL do papel limitado do portal. Guarde a credencial fora do Git.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full

# Exporte DIRECT_URL somente no ambiente de manutenção, para migração e concessão de privilégios.

# Opcional: para enviar o link de confirmação por e-mail via Resend.
# Sem essas variáveis, somente o cadastro exibe link de teste em desenvolvimento.
# Recuperação de senha exige Resend e PORTAL_PUBLIC_URL; nunca exibe token na tela.
RESEND_API_KEY=
EMAIL_FROM=

# Origem confiável para proteção de requisições e links de confirmação/recuperação.
# Sem caminho, credenciais, consulta ou fragmento. HTTPS; HTTP loopback só em desenvolvimento.
# Exemplo local: http://localhost:3002. Ainda bloqueado em produção.
PORTAL_PUBLIC_URL=

# HSTS somente após verificar TLS e proxy do endereço definitivo; não habilita autenticação.
HTTPS_VERIFIED=

# Registro experimental de minutas: desativado por padrão e sempre bloqueado em production.
# Compatibilidade com arquivos de demonstração: somente development/test.
DECLARATION_REGISTRY_PREVIEW=false

# Emissão escolar explícita (sem alterar arquivos antigos). Defina apenas no
# ambiente autorizado; exige PORTAL_PUBLIC_URL, HTTPS em produção e migrações.
# Não configura assinaturas, envio de e-mail ou autenticação em produção.
# DECLARATION_ISSUANCE_MODE=school
# PORTAL_PUBLIC_URL=https://portal.escola.example
