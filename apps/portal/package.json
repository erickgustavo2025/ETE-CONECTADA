{
  "name": "@ete-conectada/portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 3001",
    "build": "next build --webpack",
    "start": "next start -p 3001",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "prebuild": "prisma generate",
    "predev": "prisma generate",
    "test:db": "tsx scripts/test-db.ts",
    "test:schema": "node --import tsx scripts/test-schema.ts",
    "test:cleanup": "node --import tsx scripts/test-cleanup.ts",
    "test:guards": "node --import tsx scripts/test-test-environment.ts",
    "test:unit": "node --import tsx scripts/test-registration-validation.ts && node --import tsx scripts/test-password.ts && node --import tsx scripts/test-declaration-validation.ts && node --import tsx scripts/test-access-input.ts && node --import tsx scripts/test-student-details-validation.ts",
    "test:student-details": "node --import tsx scripts/test-student-details.ts",
    "test:registration": "tsx scripts/test-registration.ts",
    "diagnose:login": "node --import tsx scripts/diagnose-login.ts",
    "students:import": "node --import tsx scripts/import-students.ts",
    "access:secretary": "node --import tsx scripts/set-secretary.ts",
    "test:declarations": "node --import tsx scripts/test-declarations.ts",
    "db:demo": "node --import tsx scripts/seed.ts --demo",
    "typecheck": "prisma generate && next typegen && tsc --noEmit --incremental false",
    "lint": "eslint . --max-warnings=0",
    "format": "node ../../scripts/format.mjs --write --scope=apps/portal",
    "format:check": "node ../../scripts/format.mjs --check --scope=apps/portal",
    "test:session": "node --import tsx scripts/test-session-authorization.ts",
    "test:production": "node --import tsx scripts/test-production.ts",
    "pretest:unit": "prisma generate",
    "test:import": "node --import tsx scripts/test-student-import.ts",
    "test:browser": "node --import tsx ../../node_modules/@playwright/test/cli.js test --config tests/browser/playwright.config.ts",
    "measure:performance": "node --import tsx scripts/measure-performance.ts"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "next": "16.4.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "react": "19.2.6",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "17.3.1",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "^7.0.2"
  }
}
