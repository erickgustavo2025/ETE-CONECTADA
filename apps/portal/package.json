{
  "name": "@ete-conectada/portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 3001",
    "build": "next build --webpack",
    "start": "next start -p 3001",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "prebuild": "prisma generate",
    "predev": "prisma generate",
    "test:db": "tsx scripts/test-db.ts",
    "test:schema": "node --import tsx scripts/test-schema.ts",
    "test:cleanup": "node --import tsx scripts/test-cleanup.ts",
    "test:guards": "node --import tsx scripts/test-test-environment.ts",
    "test:unit": "node --import tsx scripts/test-registration-validation.ts && node --import tsx scripts/test-password.ts && node --import tsx scripts/test-declaration-validation.ts && node --import tsx scripts/test-access-input.ts && node --import tsx scripts/test-student-details-validation.ts && node --import tsx scripts/test-enrollment-validation.ts && node --import tsx scripts/test-password-reset-validation.ts && npm run test:sheet-input && npm run test:course-calendar-input && node --import tsx scripts/test-database-config.ts",
    "test:student-details": "node --import tsx scripts/test-student-details.ts",
    "test:registration": "tsx scripts/test-registration.ts",
    "diagnose:login": "node --import tsx scripts/diagnose-login.ts",
    "students:import": "node --import tsx scripts/import-students.ts",
    "access:secretary": "node --import tsx scripts/set-secretary.ts",
    "test:declarations": "node --import tsx scripts/test-declarations.ts",
    "db:demo": "node --import tsx scripts/prepare-demo.ts",
    "test:enrollments": "node --import tsx scripts/test-enrollments.ts",
    "typecheck": "prisma generate && next typegen && tsc --noEmit --incremental false",
    "lint": "eslint . --max-warnings=0",
    "format": "node ../../scripts/format.mjs --write --scope=apps/portal",
    "format:check": "node ../../scripts/format.mjs --check --scope=apps/portal",
    "test:session": "node --import tsx scripts/test-session-authorization.ts",
    "test:production": "node --import tsx scripts/test-production.ts",
    "pretest:unit": "prisma generate",
    "test:import": "node --import tsx scripts/test-student-import.ts",
    "test:browser": "node --import tsx ../../node_modules/@playwright/test/cli.js test --config tests/browser/playwright.config.ts",
    "measure:performance": "node --import tsx scripts/measure-performance.ts",
    "test:sheet-input": "node --import tsx scripts/test-sheet-input.ts",
    "test:sheet-import": "node --import tsx scripts/test-sheet-import.ts",
    "test:sheet-history": "node --import tsx scripts/test-sheet-history.ts",
    "test:password-reset": "node --import tsx scripts/test-password-reset.ts",
    "test:course-calendar-input": "node --import tsx scripts/test-course-calendar-input.ts",
    "test:course-calendars": "node --import tsx scripts/test-course-calendars.ts",
    "test:subsequent-import": "node --import tsx scripts/test-subsequent-import.ts",
    "test:access-throttle": "node --import tsx scripts/test-access-throttle.ts",
    "test:database-time": "node --import tsx scripts/test-database-time.ts",
    "test:private-input": "node --import tsx scripts/test-private-input.ts"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "next": "16.4.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "react": "19.2.6",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "17.3.1",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "^7.0.2"
  }
}
