generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Student {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cpf       String?  @unique @db.Char(11)
  birthDate DateTime @map("birth_date") @db.Date
  fullName  String?  @map("full_name")
  schoolRegistration String? @unique @map("school_registration")
  importSourceId String? @unique @map("import_source_id")
  registrationAllowed Boolean @default(true) @map("registration_allowed")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  account   Account?
  declarationRequests DeclarationRequest[]
  enrollments Enrollment[]
  details StudentDetails?
  @@map("students")
}

enum StudentDataSource {
  SCHOOL_RECORD
  STUDENT_DECLARATION
  SECRETARY_CORRECTION
}

model StudentDetails {
  studentId String @id @map("student_id") @db.Uuid
  parentOne String? @map("parent_one") @db.VarChar(180)
  parentTwo String? @map("parent_two") @db.VarChar(180)
  parentageSource StudentDataSource? @map("parentage_source")
  socialName String? @map("social_name") @db.VarChar(180)
  socialNameSource StudentDataSource? @map("social_name_source")
  birthCity String? @map("birth_city") @db.VarChar(120)
  birthState String? @map("birth_state") @db.VarChar(2)
  birthCountry String? @map("birth_country") @db.VarChar(2)
  birthplaceSource StudentDataSource? @map("birthplace_source")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById String? @map("updated_by_id") @db.Uuid
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  updatedBy Account? @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  @@map("student_details")
}

enum EducationMode {
  INTEGRADO
  SUBSEQUENTE
}

enum EnrollmentStatus {
  UNCONFIRMED
  ACTIVE
  ENDED
}

model Enrollment {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId String @map("student_id") @db.Uuid
  mode EducationMode
  className String @map("class_name")
  grade Int?
  courseLabel String @map("course_label")
  schoolYear Int? @map("school_year")
  status EnrollmentStatus @default(UNCONFIRMED)
  periodLabel String? @map("period_label") @db.VarChar(60)
  validFrom DateTime? @map("valid_from") @db.Date
  validUntil DateTime? @map("valid_until") @db.Date
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewedById String? @map("reviewed_by_id") @db.Uuid
  reviewedBy Account? @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  importSourceId String? @unique @map("import_source_id")
  schoolImportKey String? @unique @map("school_import_key") @db.VarChar(80)
  moduleNumber Int? @map("module_number")
  offeringId String? @map("offering_id") @db.Uuid
  calendarModule Int? @map("calendar_module")
  calendarRevision Int? @map("calendar_revision")
  progressionHeld Boolean @default(true) @map("progression_held")
  offering CourseOffering? @relation(fields: [offeringId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  declarationRequests DeclarationRequest[]
  importHistory EnrollmentImportHistory[]
  @@index([studentId])
  @@index([className])
  @@index([offeringId])
  @@map("enrollments")
}

model Account {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId    String   @unique @map("student_id") @db.Uuid
  email        String?  @unique
  passwordHash String?  @map("password_hash")
  status       String   @default("unclaimed")
  role         String   @default("student")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  passwordResetAt DateTime? @map("password_reset_at") @db.Timestamptz(6)
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  preparedDeclarations DeclarationRequest[] @relation("PreparedBy")
  completedDeclarations DeclarationRequest[] @relation("ReadyBy")
  sessions     Session[]
  verificationTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  updatedStudentDetails StudentDetails[]
  reviewedEnrollments Enrollment[]
  sheetImportPreview SheetImportPreview?
  recordedEnrollmentImports EnrollmentImportHistory[]
  calendarVersions CourseCalendarVersion[]
  @@map("accounts")
}

model PasswordResetToken {
  tokenHash String @id @map("token_hash") @db.Char(64)
  accountId String @map("account_id") @db.Uuid
  credentialHash String @map("credential_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@index([accountId])
  @@map("password_reset_tokens")
}

model Session {
  tokenHash String @id @map("token_hash")
  accountId String @map("account_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@index([accountId])
  @@index([expiresAt])
  @@map("sessions")
}

model EmailVerificationToken {
  tokenHash String @id @map("token_hash")
  claimDataHash String? @map("claim_data_hash") @db.Char(64)
  accountId String @map("account_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@index([accountId])
  @@map("email_verification_tokens")
}

enum DeclarationRequestStatus {
  REQUESTED
  IN_PREPARATION
  READY_FOR_PICKUP
}

model DeclarationRequest {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId String @map("student_id") @db.Uuid
  enrollmentId String @map("enrollment_id") @db.Uuid
  status DeclarationRequestStatus @default(REQUESTED)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  generatedAt DateTime? @map("generated_at") @db.Timestamptz(6)
  readyAt DateTime? @map("ready_at") @db.Timestamptz(6)
  preparedById String? @map("prepared_by_id") @db.Uuid
  readyById String? @map("ready_by_id") @db.Uuid
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  preparedBy Account? @relation("PreparedBy", fields: [preparedById], references: [id], onDelete: SetNull)
  readyBy Account? @relation("ReadyBy", fields: [readyById], references: [id], onDelete: SetNull)
  @@index([studentId, createdAt])
  @@index([status, createdAt])
  @@index([enrollmentId])
  @@map("declaration_requests")
}

// Histórico anterior ao Prisma, preservado para auditoria.
model LegacyMigration {
  version String @id
  appliedAt DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)
  @@map("portal_schema_migrations")
}

// Guarda somente hashes e contagens; o arquivo e os dados pessoais não são retidos.
model SheetImportPreview {
  actorId String @id @map("actor_id") @db.Uuid
  tokenHash String @unique @map("token_hash") @db.Char(64)
  inputHash String @map("input_hash") @db.Char(64)
  snapshotHash String @map("snapshot_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  result Json?
  actor Account @relation(fields: [actorId], references: [id], onDelete: Cascade)
  @@map("sheet_import_previews")
}

// Estado anterior à alteração pelo XLS; não copia nome, nascimento ou filiação.
model EnrollmentImportHistory {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enrollmentId String @map("enrollment_id") @db.Uuid
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)
  recordedById String? @map("recorded_by_id") @db.Uuid
  reason String @db.VarChar(32)
  mode EducationMode
  className String @map("class_name")
  grade Int?
  moduleNumber Int? @map("module_number")
  courseLabel String @map("course_label")
  offeringId String? @map("offering_id") @db.Uuid
  calendarRevision Int? @map("calendar_revision")
  progressionHeld Boolean? @map("progression_held")
  schoolYear Int? @map("school_year")
  periodLabel String? @map("period_label") @db.VarChar(60)
  validFrom DateTime? @map("valid_from") @db.Date
  validUntil DateTime? @map("valid_until") @db.Date
  status EnrollmentStatus
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(6)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  recordedBy Account? @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  @@index([enrollmentId, recordedAt, id])
  @@index([recordedById])
  @@map("enrollment_import_history")
}


model CourseOffering {
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 label String @db.VarChar(120)
 courseLabel String @map("course_label") @db.VarChar(3)
 lastImportAt DateTime? @map("last_import_at") @db.Timestamptz(6)
 lastImportModule Int? @map("last_import_module")
 lastImportPeriod String? @map("last_import_period") @db.VarChar(60)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
 calendars CourseCalendarVersion[]
 enrollments Enrollment[]
 @@map("course_offerings")
}
model CourseCalendarVersion {
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 offeringId String @map("offering_id") @db.Uuid
 revision Int
 schedule Json
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
 createdById String? @map("created_by_id") @db.Uuid
 offering CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Restrict, onUpdate: NoAction)
 createdBy Account? @relation(fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
 @@unique([offeringId,revision])
 @@index([createdById])
 @@map("course_calendar_versions")
}
