{
  "name": "ete-conectada",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:site": "npm run dev --workspace @ete-conectada/site",
    "dev:portal": "npm run dev --workspace @ete-conectada/portal",
    "build": "npm run build --workspaces --if-present",
    "students:import": "npm run students:import --workspace @ete-conectada/portal --",
    "access:secretary": "npm run access:secretary --workspace @ete-conectada/portal --",
    "test:registration": "npm run test:registration --workspace @ete-conectada/portal",
    "test:declarations": "npm run test:declarations --workspace @ete-conectada/portal",
    "test:guards": "npm run test:guards --workspace @ete-conectada/portal",
    "test:schema": "npm run test:schema --workspace @ete-conectada/portal",
    "test:integration": "npm run test:import && npm run test:registration && npm run test:password-reset && npm run test:declarations && npm run test:session && npm run test:production && npm run test:student-details && npm run test:enrollments && npm run test:course-calendars && npm run test:sheet-import && npm run test:sheet-history && npm run test:subsequent-import && npm run test:db --workspace @ete-conectada/portal",
    "test:enrollments": "npm run test:enrollments --workspace @ete-conectada/portal",
    "test:student-details": "npm run test:student-details --workspace @ete-conectada/portal",
    "test:cleanup": "npm run test:cleanup --workspace @ete-conectada/portal",
    "test:unit": "npm run test:unit --workspace @ete-conectada/portal",
    "audit:dependencies": "npm audit --audit-level=high",
    "db:demo": "npm run db:demo --workspace @ete-conectada/portal",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint apps shared scripts eslint.config.mjs --max-warnings=0",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs --check",
    "format:check:all": "node scripts/format.mjs --check --all",
    "test:session": "npm run test:session --workspace @ete-conectada/portal",
    "test:production": "npm run test:production --workspace @ete-conectada/portal",
    "test:import": "npm run test:import --workspace @ete-conectada/portal",
    "test:browser": "npm run test:browser --workspace @ete-conectada/portal",
    "measure:performance": "npm run measure:performance --workspace @ete-conectada/portal",
    "test:sheet-import": "npm run test:sheet-import --workspace @ete-conectada/portal",
    "test:sheet-history": "npm run test:sheet-history --workspace @ete-conectada/portal",
    "test:password-reset": "npm run test:password-reset --workspace @ete-conectada/portal",
    "test:course-calendars": "npm run test:course-calendars --workspace @ete-conectada/portal",
    "test:subsequent-import": "npm run test:subsequent-import --workspace @ete-conectada/portal"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.4.0",
    "prettier": "3.8.1",
    "typescript-eslint": "8.71.1"
  }
}
